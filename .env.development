# API (Use Vite proxy instead of direct backend connection)
VITE_API_BASE_URL=/api
VITE_STATIC_BASE_URL=http://localhost:8080

# App
VITE_APP_ENV=development
VITE_APP_NAME=MZC Learn

# Feature Flags
VITE_ENABLE_MOCK=false

# Mock Mode - Set to true to use mock data instead of real API
VITE_MOCK_ENABLED=false

# Dev Auth Bypass (개발 시 인증 우회 - true로 설정하면 로그인 없이 접근 가능)
VITE_DEV_BYPASS_AUTH=true
